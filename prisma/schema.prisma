generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Session storage for Shopify app authentication
model Session {
  id     String  @id @db.VarChar(255)
  shop   String @db.VarChar(100)
  state  String @db.VarChar(100)
  isOnline Boolean @default(false)
  accessToken String @db.VarChar(500)
  refreshToken String? @db.VarChar(500)
  refreshTokenExpires DateTime?
  scope String?
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop])
}

// Instagram account linked to Shopify store
model InstagramAccount {
  id String @id @default(cuid())
  shopDomain String @db.VarChar(100)
  igUserId String @db.VarChar(50)
  igBusinessAccountId String @db.VarChar(50)
  igUsername String @db.VarChar(100)
  accessToken String @db.LongText
  refreshToken String? @db.LongText
  refreshTokenExpires DateTime?
  profileUrl String? @db.VarChar(500)
  profilePicture String? @db.VarChar(500)
  followerCount Int @default(0)
  lastSyncedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  media InstagramMedia[]
  stories InstagramStory[]
  highlights InstagramHighlight[]
  feedSettings FeedSettings?

  @@unique([shopDomain, igUsername])
  @@index([shopDomain])
}

// Instagram media (posts from linked account)
model InstagramMedia {
  id String @id @db.VarChar(100)
  shopDomain String @db.VarChar(100)
  accountId String @db.VarChar(50)
  caption String? @db.LongText
  mediaType String @db.VarChar(20) // IMAGE, VIDEO, CAROUSEL
  mediaUrl String @db.LongText
  thumbnailUrl String? @db.LongText
  permalink String @db.VarChar(500)
  timestamp DateTime
  engagementCount Int @default(0)
  impressionCount Int @default(0)
  blurHash String? @db.VarChar(255) // Blur-hash placeholder for faster loading
  syncedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  account InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  hiddenPosts HiddenPost[]
  productTags MediaProductTag[]
  categories Category[]

  @@unique([id, shopDomain])
  @@index([shopDomain])
  @@index([accountId])
  @@index([timestamp])
}

// Instagram stories
model InstagramStory {
  id String @id @db.VarChar(100)
  shopDomain String @db.VarChar(100)
  accountId String @db.VarChar(50)
  mediaType String @db.VarChar(20) // IMAGE, VIDEO
  mediaUrl String @db.LongText
  thumbnailUrl String? @db.LongText
  timestamp DateTime
  expiresAt DateTime?
  syncedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  account InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  productTags StoryProductTag[]
  highlightId String? @db.VarChar(100)
  highlight InstagramHighlight? @relation(fields: [highlightId], references: [id], onDelete: SetNull)

  @@unique([id, shopDomain])
  @@index([shopDomain])
  @@index([accountId])
  @@index([timestamp])
}

// Instagram highlights (collections of stories)
model InstagramHighlight {
  id String @id @db.VarChar(100)
  shopDomain String @db.VarChar(100)
  accountId String @db.VarChar(50)
  title String @db.VarChar(100)
  coverUrl String @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  account InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  stories InstagramStory[]

  @@unique([id, shopDomain])
  @@index([shopDomain])
  @@index([accountId])
}

// Product tags on Instagram media
model MediaProductTag {
  id String @id @default(cuid())
  mediaId String @db.VarChar(100)
  shopDomain String @db.VarChar(100)
  productId String @db.VarChar(100) // Shopify Product ID (e.g., gid://shopify/Product/12345)
  productHandle String @db.VarChar(255) // For easy linking
  x Float? // X coordinate for tag on image (0-100)
  y Float? // Y coordinate for tag on image (0-100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media InstagramMedia @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, productId])
  @@index([shopDomain])
  @@index([productId])
}

// Product tags on Instagram stories
model StoryProductTag {
  id String @id @default(cuid())
  storyId String @db.VarChar(100)
  shopDomain String @db.VarChar(100)
  productId String @db.VarChar(100)
  productHandle String @db.VarChar(255)
  x Float?
  y Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  story InstagramStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, productId])
  @@index([shopDomain])
  @@index([productId])
}

// Hidden/excluded posts (Premium feature)
model HiddenPost {
  id String @id @default(cuid())
  shopDomain String @db.VarChar(100)
  mediaId String @db.VarChar(100)
  reason String? @db.VarChar(255)
  createdAt DateTime @default(now())
  
  media InstagramMedia @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, shopDomain])
  @@index([shopDomain])
}

// Feed display settings per store
model FeedSettings {
  id String @id @default(cuid())
  shopDomain String @db.VarChar(100)
  accountId String @db.VarChar(50) @unique
  displayLayout String @default("grid") @db.VarChar(50) // grid, masonry, carousel
  postsPerPage Int @default(12)
  autoRefreshInterval Int @default(3600) // seconds
  enableLightbox Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  account InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([shopDomain])
  @@index([shopDomain])
}

// Theme extension settings (Premium layouts, colors, etc.)
model ThemeExtensionSettings {
  id String @id @default(cuid())
  shopDomain String @db.VarChar(100) @unique
  themeJson String @db.LongText // JSON config for theme
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopDomain])
}

// Customizable Feed Widgets for Personalization
model FeedWidget {
  id String @id @default(cuid())
  shopDomain String @db.VarChar(100)
  name String @db.VarChar(100) // e.g., "US Homepage Feed"
  
  // Targeting rules
  targetCountries String? @db.VarChar(500) // Comma-separated country codes (e.g., "US,CA,GB"), null means all
  targetPages String? @db.VarChar(500) // Comma-separated page types or paths (e.g., "index,product,/pages/about"), null means all
  
  // Content filtering
  hashtagFilter String? @db.VarChar(255) // Only show posts with this hashtag
  
  // Display settings
  displayLayout String @default("grid") @db.VarChar(50)
  postsPerPage Int @default(12)
  
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([shopDomain])
}

// Categories for organizing Instagram media
model Category {
  id String @id @default(cuid())
  shopDomain String @db.VarChar(100)
  name String @db.VarChar(100)
  slug String @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media InstagramMedia[]

  @@unique([shopDomain, slug])
  @@index([shopDomain])
}
